# LUMINA Impact backend — copy to .env and fill in.
LUMINA_DATABASE_URL=postgresql+psycopg://lumina:lumina@localhost:5432/lumina
LUMINA_REDIS_URL=redis://localhost:6379/0

# Crawlers
LUMINA_RELIEFWEB_APPNAME=lumina-impact
LUMINA_GOOGLE_CSE_API_KEY=
LUMINA_GOOGLE_CSE_ENGINE_ID=

# Dispatch / notifications
LUMINA_DISPATCH_EMAIL=hello@storitellah.com
LUMINA_SMTP_HOST=
LUMINA_SMTP_PORT=587
LUMINA_SMTP_USER=
LUMINA_SMTP_PASSWORD=
LUMINA_DAILY_DIGEST_HOUR_EAT=8
